# Copy to `.env` and fill in real values. Never commit `.env`.

# ── Required now (Phase 0) ─────────────────────────────────────────────────────

# Port the API listens on. Railway injects this automatically in production.
PORT=3001

# Comma-separated allowlist of frontend origins permitted to send credentials.
# Must be exact origins — "*" is rejected, because credentialed CORS forbids it.
# Local:      http://localhost:3000
# Production: https://<your-app>.vercel.app
WEB_ORIGIN=http://localhost:3000

# development | production | test
NODE_ENV=development

# ── Added in Phase 1 (Prisma + Supabase) ──────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# Pooled connection (port 6543) is what the running app uses.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) is what `prisma migrate` needs.
# DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"

# ── Added in Phase 2 (auth) ───────────────────────────────────────────────────
# Long random string, e.g. `openssl rand -base64 48`.
# JWT_SECRET=

# ── Added in Phase 5 (upload) ─────────────────────────────────────────────────
# Supabase → Project Settings → API.
# SUPABASE_URL="https://<ref>.supabase.co"
# Service-role key. Server-side only — never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=data-room-files
