# Copy to `.env` and fill in real values. Never commit `.env`.

# ── Required now (Phase 0) ─────────────────────────────────────────────────────

# Port the API listens on. Railway injects this automatically in production.
PORT=3001

# Comma-separated allowlist of frontend origins permitted to send credentials.
# Must be exact origins — "*" is rejected, because credentialed CORS forbids it.
# Local:      http://localhost:3000
# Production: https://<your-app>.vercel.app
WEB_ORIGIN=http://localhost:3000

# development | production | test
NODE_ENV=development

# Supabase → Project Settings → Database → Connection string.
#
# Pooled connection (port 6543). Used by the running application.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:6543/postgres?pgbouncer=true"
#
# Direct connection (port 5432). Used by `prisma migrate`, `prisma studio` and
# the seed — transaction-mode pooling cannot hold the locks migrations need.
# Required even for `prisma generate`, which loads prisma.config.ts eagerly, so
# a deploy without it fails at build time.
DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"

# Signing key for access tokens. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Access-token lifetime in seconds. Defaults to 7 days.
# JWT_EXPIRES_IN_SECONDS=604800

# ── Optional: integration tests ───────────────────────────────────────────────
# Same database as DIRECT_URL but with `?schema=test`, so `pnpm test:int` can
# truncate tables without touching application data. Apply migrations to it with
# `pnpm db:migrate:test`.
#
# Leave this unset and the integration suite skips itself — `pnpm test` still
# passes on a machine with no database.
# TEST_DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres?schema=test"

# ── Added in Phase 5 (upload) ─────────────────────────────────────────────────
# Supabase → Project Settings → API.
# SUPABASE_URL="https://<ref>.supabase.co"
# Service-role key. Server-side only — never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=data-room-files
