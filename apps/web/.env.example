# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# Base URL of the NestJS API, with no trailing slash.
# Local:      http://localhost:3001
# Production: https://<your-service>.up.railway.app
#
# This is a NEXT_PUBLIC_ variable: it is inlined into the browser bundle at
# build time, so changing it on Vercel requires a redeploy, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:3001
